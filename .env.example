# Environment Configuration Example for PETR4.SA Prediction API
# Copy this file to .env and modify as needed

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Application Settings
TITLE="PETR4.SA Prediction API"
SECRET_KEY=your_secret_key_here_change_in_production

# Model Configuration
MODEL_PATH=model_pipeline/artifacts/best_model.pth
SCALER_PATH=model_pipeline/artifacts/scaler.joblib

# Data Provider Settings
CACHE_DURATION_MINUTES=15
DEFAULT_DATA_PERIOD=1y

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# API Rate Limiting (optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Development Settings
DEBUG=false
RELOAD=false

# Security (for production)
HTTPS_ONLY=false
CORS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database (if needed for future features)
# DATABASE_URL=sqlite:///./petr4_predictions.db

# Monitoring (if needed)
# SENTRY_DSN=your_sentry_dsn_here
# PROMETHEUS_ENABLED=false